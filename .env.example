# MedAkis yerel ayar örneği. Gerekirse .env olarak kopyalayın (.env git dışındadır).
# Bu dosyaya ve .env dosyasına PAROLA YAZILMAZ.
# Parolalar gizli girişle alınır ve Windows Credential Manager'da tutulur:
#   scripts\db\setup.ps1 ve scripts\db\store_credentials.py

# PostgreSQL'in bu bilgisayarda dinleyeceği port (yalnız 127.0.0.1).
MEDAKIS_PG_PORT=5432

# Uygulamanın bağlanacağı adres ve veritabanı (ortam değişkeni olarak okunur; yalnız yerel adres).
# Kullanıcı adı ayarlanmaz: uygulama medakis_app/medakis_rag, migration medakis_owner kullanır.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=medakis_dev

# Telegram onay bildirimi (varsayılan DRY-RUN: ağ isteği yapılmaz).
# Gerçek gönderim için üçü birlikte gerekir. Token'ı yalnız oturum ortam değişkeni olarak verin;
# hiçbir dosyaya, loga ya da commit'e yazmayın. Daha önce paylaşılmış bir token ifşa edilmiş sayılır ve yenilenmelidir.
MEDAKIS_TELEGRAM_MODE=dry_run
# TELEGRAM_BOT_TOKEN=   (yalnız oturum ortam değişkeni; bu dosyaya ve .env içine yazılmaz)
# TELEGRAM_CHAT_ID=     (yalnız oturum ortam değişkeni)

# Denetim izlerinin yazılacağı dizin (verilmezse depodaki git dışı data/ klasörü).
# MEDAKIS_DATA_DIR=
